# =====================================================================
# FaithOn — Environment variables
# Copy to .env and fill values. .env is gitignored.
# =====================================================================

# ---------- Server ----------
PORT=5500
APP_URL=https://www.faithon.ai
ADMIN_URL=https://www.faithon.ai/admin

# FaithOn public SMS number (E.164). Used by /pray deep-link.
FAITHON_SMS_NUMBER=+19547950686

# ---------- Supabase (backend + admin) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ANON_KEY=<anon-jwt>
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>   # server-only; never ship to browser

# ---------- Supabase (Next admin app, when scaffolded) ----------
# Next reads *only* NEXT_PUBLIC_* vars in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-jwt>

# ---------- Stripe ----------
# Use restricted keys (rk_live_*) for local dev to avoid write-blast on live account.
STRIPE_SECRET_KEY=<sk_live_or_rk_live>
STRIPE_PUBLISHABLE_KEY=<pk_live_or_pk_test>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_live_or_pk_test>
STRIPE_WEBHOOK_SECRET=<whsec_...>
# Fixed price id — create the price once in the Stripe dashboard and paste here.
# Prefer this over runtime price creation (see server.js).
STRIPE_PLUS_PRICE_ID=<price_...>

# ---------- SMS Provider ----------
# Provider-agnostic SMS config. Supported: smsgate
# Future: twilio, cloudtalk, etc.
SMS_PROVIDER=smsgate

# ---------- SMSGate (Android SMS Gateway) ----------
# Local mode: the Android app exposes an HTTP API on the device IP.
# Set base URL without trailing path (e.g. http://192.168.15.2:8080).
SMSGATE_URL=http://192.168.15.2:8080
SMSGATE_USER=sms
SMSGATE_PASS=Gab@2020

# ---------- AI Provider ----------
# Supported: deepseek, openai
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=160                     # keep SMS replies short
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=15000

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=<sk-...>
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # optional: only change for proxies

# ---------- OpenAI (optional fallback) ----------
OPENAI_API_KEY=<sk-...>
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o

# ---------- n8n (optional, secondary automations only) ----------
N8N_WEBHOOK_SECRET=<random-shared-secret>  # signs requests from n8n → this API
N8N_BASE_URL=https://n8n.example.com       # optional: for outbound calls to n8n

# ---------- Cron / scheduled jobs ----------
CRON_SECRET=<random-shared-secret>         # protects /api/cron/* endpoints
