# =====================================================================
# FaithOn — Environment variables
# Copy to .env and fill values. .env is gitignored.
# =====================================================================

# ---------- Server ----------
PORT=5500
APP_URL=https://www.faithon.ai
ADMIN_URL=https://www.faithon.ai/admin

# ---------- Supabase (backend + admin) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ANON_KEY=<anon-jwt>
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>   # server-only; never ship to browser

# ---------- Supabase (Next admin app, when scaffolded) ----------
# Next reads *only* NEXT_PUBLIC_* vars in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-jwt>

# ---------- Stripe ----------
# Use restricted keys (rk_live_*) for local dev to avoid write-blast on live account.
STRIPE_SECRET_KEY=<sk_live_or_rk_live>
STRIPE_PUBLISHABLE_KEY=<pk_live_or_pk_test>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_live_or_pk_test>
STRIPE_WEBHOOK_SECRET=<whsec_...>
# Fixed price id — create the price once in the Stripe dashboard and paste here.
# Prefer this over runtime price creation (see server.js).
STRIPE_PLUS_PRICE_ID=<price_...>

# ---------- Twilio (SMS) ----------
TWILIO_ACCOUNT_SID=<AC...>
TWILIO_AUTH_TOKEN=<...>
TWILIO_PHONE_NUMBER=+1<10digits>
TWILIO_WEBHOOK_AUTH_TOKEN=<...>       # for validating inbound webhook signatures
TWILIO_STATUS_CALLBACK_URL=https://www.faithon.ai/api/twilio/status

# ---------- OpenAI ----------
OPENAI_API_KEY=<sk-...>
OPENAI_MODEL=gpt-4o-mini              # primary (also stored in app_settings)
OPENAI_FALLBACK_MODEL=gpt-4o          # used on error/limit

# ---------- n8n ----------
N8N_WEBHOOK_SECRET=<random-shared-secret>  # signs requests from n8n → this API
N8N_BASE_URL=https://n8n.example.com       # optional: for outbound calls to n8n

# ---------- Cron / scheduled jobs ----------
CRON_SECRET=<random-shared-secret>         # protects /api/cron/* endpoints
